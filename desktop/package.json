{
  "name": "tanstack-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "TanStack desktop host",
  "author": "TanStack",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "install-electron && node build-device-helper.mjs && electron .",
    "pack": "electron-builder --config builder.config.mjs --dir -c.forceCodeSigning=false --publish never",
    "dist": "electron-builder --config builder.config.mjs --mac --publish never",
    "test": "node build-device-helper.mjs && node --test *.test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3"
  }
}

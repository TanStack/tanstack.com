{
  "account_id": "8da95258a9c70b54c3e2b374a0079106",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "limits": {
    "cpu_ms": 300000,
  },
  "workers_dev": false,
  "preview_urls": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6ec1513b87bb47e9897e5502727b0388",
    },
  ],
  "name": "tanstack-starter",
  "main": "../../src/workers/starter.ts",
  "vars": {
    "APP_MODE": "production",
  },
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "ENCRYPTION_KEY",
      "GITHUB_AUTH_TOKEN",
      "DATABASE_URL",
    ],
  },
}

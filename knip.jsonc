{
  "$schema": "https://unpkg.com/knip@6.32.0/schema-jsonc.json",
  "include": ["files", "dependencies", "devDependencies"],
  "workspaces": {
    ".": {
      "entry": [
        "content-collections.ts",
        "src/{router.tsx,start.ts}",
        "src/routes/**/*.{ts,tsx}",
        "!src/routes/**/-*",
        "src/workers/{chat,chat-recovery,og,starter}.ts",
        "public/tanchat-sw.js",
        "scripts/**/*.{js,mjs,ts}",
        "{tests,harness-tests}/**/*.test.{ts,tsx}",
      ],
      "project": ["src/**/*.{js,jsx,ts,tsx,css}"],
      // Analyze vite.config.ts without executing it through Knip's config loader.
      "vite": { "config": [] },
      // Existing findings at adoption. Delete entries as the corresponding code is cleaned up.
      "ignoreFiles": [
        "src/chat/components/FavoriteShortcuts.tsx",
        "src/chat/components/marketing-welcome.css",
        "src/chat/components/ui/Switch.tsx",
        "src/chat/components/ui/TextInput.tsx",
        "src/chat/components/ui/switch.css",
        "src/chat/components/ui/text-input.css",
        "src/chat/components/useHomeFavorites.ts",
        "src/chat/message-references.ts",
        "src/chat/preferences.functions.ts",
        "src/chat/server/semantic-history.ts",
        "src/chat/skill-identifiers.ts",
        "src/components/BackgroundGradient.tsx",
        "src/components/BlockWithFeedback.tsx",
        "src/components/BlogAuthorFilter.tsx",
        "src/components/BlogSearchFilter.tsx",
        "src/components/BottomCTA.tsx",
        "src/components/DocFeedbackContext.tsx",
        "src/components/DocsCalloutNewsletter.tsx",
        "src/components/FrameworkIconTabs.tsx",
        "src/components/Gam.tsx",
        "src/components/LandingCommunitySection.tsx",
        "src/components/LandingPageGad.tsx",
        "src/components/LibraryDownloadsMicro.tsx",
        "src/components/LibraryStatsSection.tsx",
        "src/components/LibraryTestimonials.tsx",
        "src/components/Logo.tsx",
        "src/components/LogoColor.tsx",
        "src/components/LogoQueryGG.tsx",
        "src/components/LogoQueryGGSmall.tsx",
        "src/components/MaintainersSection.tsx",
        "src/components/Mounted.tsx",
        "src/components/OptimizedImage.tsx",
        "src/components/PartnersSection.tsx",
        "src/components/PartnershipCallout.tsx",
        "src/components/QueryGGBanner.tsx",
        "src/components/SponsorsSection.tsx",
        "src/components/StackBlitzEmbed.tsx",
        "src/components/StackBlitzSection.tsx",
        "src/components/Style.tsx",
        "src/components/TocMobile.tsx",
        "src/components/UserFeedbackSection.tsx",
        "src/components/application-starter/CustomAddonDialog.tsx",
        "src/components/application-starter/CustomTemplateDialog.tsx",
        "src/components/application-starter/FeaturePicker.tsx",
        "src/components/application-starter/TemplatePicker.tsx",
        "src/components/application-starter/index.ts",
        "src/components/game/engine/entities/index.ts",
        "src/components/game/hooks/useAIOpponents.ts",
        "src/components/game/hooks/useBoatControls.ts",
        "src/components/game/scene/AIShips.tsx",
        "src/components/game/scene/BeachChair.tsx",
        "src/components/game/scene/Boat.tsx",
        "src/components/game/scene/BoundaryWalls.tsx",
        "src/components/game/scene/Cannonballs.tsx",
        "src/components/game/scene/Coin.tsx",
        "src/components/game/scene/Dinghy.tsx",
        "src/components/game/scene/Flag.tsx",
        "src/components/game/scene/GameScene.tsx",
        "src/components/game/scene/Island.tsx",
        "src/components/game/scene/IslandInfo3D.tsx",
        "src/components/game/scene/IslandLobe.tsx",
        "src/components/game/scene/Ocean.tsx",
        "src/components/game/scene/OceanRocks.tsx",
        "src/components/game/scene/PalmTree.tsx",
        "src/components/game/scene/Ship.tsx",
        "src/components/game/scene/Sky.tsx",
        "src/components/game/scene/TikiShack.tsx",
        "src/components/game/scene/VirtualizedCoins.tsx",
        "src/components/game/scene/VirtualizedIslands.tsx",
        "src/components/game/ui/DiscoveryProgress.tsx",
        "src/components/icons/BaseballCapIcon.tsx",
        "src/components/icons/YinYangIcon.tsx",
        "src/components/landing/HotkeysShortcut.client.tsx",
        "src/components/landing/LandingCodeExampleCard.tsx",
        "src/components/landing/LandingEcosystemProof.tsx",
        "src/components/landing/codeExamples.ts",
        "src/components/npm-stats/index.ts",
        "src/components/shop/ShopDropCard.tsx",
        "src/components/shop/ShopStrip.tsx",
        "src/hooks/useQueryGGPPPDiscount.ts",
        "src/libraries/cli.tsx",
        "src/libraries/config.tsx",
        "src/libraries/db.tsx",
        "src/libraries/devtools.tsx",
        "src/libraries/form.tsx",
        "src/libraries/hotkeys.tsx",
        "src/libraries/intent.tsx",
        "src/libraries/pacer.tsx",
        "src/libraries/query.tsx",
        "src/libraries/ranger.tsx",
        "src/libraries/react-charts.ts",
        "src/libraries/router.tsx",
        "src/libraries/start.tsx",
        "src/libraries/store.tsx",
        "src/libraries/table.tsx",
        "src/libraries/virtual.tsx",
        "src/libraries/workflow.tsx",
        "src/mcp/oauth.server.ts",
        "src/queries/auth.ts",
        "src/server/blog.ts",
        "src/server/runtime/ejs-compat.server.ts",
        "src/server/sponsors.ts",
        "src/utils/auth.client.ts",
        "src/utils/cookies.server.ts",
        "src/utils/docFeedback.client.ts",
        "src/utils/oauth.server.ts",
        "src/utils/oauthMcp.functions.ts",
        "src/utils/showcase.client.ts",
      ],
      "ignoreDependencies": [
        "@react-three/drei",
        "@tanstack/pacer",
        "@tanstack/react-start-client",
        "@types/hast",
        "@types/linkify-it",
        "@types/remove-markdown",
        "discord-interactions",
        "encoding-sniffer",
        "gray-matter",
        "iconv-lite",
        "parse5-parser-stream",
        "remove-markdown",
        "source-map-explorer",
      ],
    },
    "desktop": {
      "entry": ["builder.config.mjs", "preload.cjs", "*.test.mjs"],
    },
  },
}

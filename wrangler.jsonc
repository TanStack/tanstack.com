{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-com",
  "account_id": "8da95258a9c70b54c3e2b374a0079106",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "cache": {
    "enabled": false,
  },
  "vars": {
    "APP_MODE": "production",
    "MCP_EGRESS_MODE": "cloudflare-public",
    "KODY_ORIGIN": "https://kody.codes",
    "INCLUDED_MODEL": "@cf/moonshotai/kimi-k2.6",
  },
  "limits": {
    "cpu_ms": 300000,
  },
  "durable_objects": {
    "bindings": [
      { "name": "STREAMS", "class_name": "StreamObject" },
      { "name": "WORKSPACE_SYNC", "class_name": "WorkspaceSync" },
      { "name": "CONVERSATIONS", "class_name": "Conversation" },
    ],
  },
  "migrations": [
    {
      "tag": "tanchat-v1",
      "new_sqlite_classes": ["StreamObject", "WorkspaceSync"],
    },
    { "tag": "tanchat-v2", "new_sqlite_classes": ["Conversation"] },
  ],
  "workflows": [
    {
      "name": "tanstack-chat-workflows",
      "binding": "WORKFLOW_RUNS",
      "class_name": "TanChatWorkflow",
    },
  ],
  "triggers": {
    "crons": ["* * * * *", "0 9 * * *", "0 */6 * * *"],
  },
  "assets": {
    "binding": "ASSETS",
  },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "GITHUB_CONTENT_CACHE",
      "bucket_name": "tanstack-github-content-cache",
    },
    {
      "binding": "NPM_DOWNLOAD_CACHE",
      "bucket_name": "tanstack-npm-download-cache",
    },
    {
      "binding": "BUILDER_PROJECTS",
      "bucket_name": "tanstack-notebook-projects",
    },
    {
      "binding": "FILES",
      "bucket_name": "tanstack-notebook-projects",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6ec1513b87bb47e9897e5502727b0388",
    },
  ],
}
